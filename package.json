{
  "name": "aivo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:all": "turbo run dev --parallel",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile dev",
    "dev:auth": "pnpm --filter @aivo/auth dev",
    "dev:nutrition": "pnpm --filter @aivo/nutrition dev",
    "dev:coach": "pnpm --filter @aivo/coach dev",
    "dev:health": "pnpm --filter @aivo/health dev",
    "dev:mail": "pnpm --filter @aivo/mail dev",
    "dev:gateway": "pnpm --filter @aivo/gateway dev",
    "dev:setup": "bash scripts/dev-setup.sh",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test --continue",
    "test:watch": "turbo run test --watch"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "zod": "4.5.4"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1"
  }
}
