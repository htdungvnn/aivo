{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
      "env": ["NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["WRANGLER_INSPECTOR_ENABLED"]
    },
    "gateway#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "gateway#dev": {
      "cache": false,
      "persistent": true,
      "env": ["WRANGLER_INSPECTOR_ENABLED"]
    },
    "wasm#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.rs", "Cargo.toml", "Cargo.lock"],
      "outputs": ["dist/**", "target/**"],
      "env": ["CARGO_TARGET_DIR"]
    },
    "wasm#check": {
      "dependsOn": [],
      "inputs": ["src/**/*.rs", "Cargo.toml"],
      "outputs": []
    },
    "wasm#test": {
      "dependsOn": ["wasm#build"],
      "inputs": ["src/**/*.rs", "tests/**"],
      "outputs": ["target/**"]
    },
    "wasm#lint": {
      "dependsOn": [],
      "inputs": ["src/**/*.rs"],
      "outputs": []
    }
  },
  "globalDependencies": [
    "tsconfig.json",
    "Cargo.toml",
    "rust-toolchain.toml"
  ],
  "globalEnv": [
    "CARGO_TARGET_DIR",
    "RUSTUP_TOOLCHAIN",
    "WASM_TARGET"
  ],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    }
  }
}
