# ============================================
# AIVO - Environment Variables Template
# ============================================
# Copy this file to .env.development for local development
# cp .env.example .env.development
# And fill in your values

# ============================================
# CLOUDFLARE CONFIGURATION
# ============================================
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=cfut_xxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# SERVICE PORTS (Development)
# ============================================
WEB_PORT=3000
AUTH_PORT=3001
NUTRITION_PORT=3002
COACH_PORT=3003
HEALTH_PORT=3004
MAIL_PORT=3005
GATEWAY_PORT=4000

# ============================================
# AUTH SERVICE (JWT Keys)
# ============================================
# Generate EC P-256 key pair:
# openssl ecparam -name prime256v1 -genkey -noout -out /tmp/private.pem
# openssl ec -in /tmp/private.pem -pubout -out /tmp/public.pem
# cat /tmp/private.pem | base64
# cat /tmp/public.pem | base64
AUTH_JWT_PRIVATE_KEY=<base64-encoded-private-key>
AUTH_JWT_PUBLIC_KEY=<base64-encoded-public-key>
AUTH_JWT_ISSUER=aivo
AUTH_JWT_AUDIENCE=aivo-app
AUTH_JWT_ACCESS_TOKEN_TTL=900
AUTH_JWT_REFRESH_TOKEN_TTL=604800

# ============================================
# OAUTH CREDENTIALS
# ============================================
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback/google

# Facebook OAuth: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=xxxxxxxxxxxxxxxx
FACEBOOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FACEBOOK_REDIRECT_URI=http://localhost:3001/auth/callback/facebook

# ============================================
# EMAIL SERVICE (Resend)
# ============================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=AIVO Dev <dev@aivo.website>

# ============================================
# SERVICE URLs (Development)
# ============================================
WEB_APP_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
NUTRITION_SERVICE_URL=http://localhost:3002
COACH_SERVICE_URL=http://localhost:3003
HEALTH_SERVICE_URL=http://localhost:3004
MAIL_SERVICE_URL=http://localhost:3005
GATEWAY_SERVICE_URL=http://localhost:4000
MOBILE_REDIRECT_URI=aivo://oauth/callback

# ============================================
# CORS (Development)
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# ============================================
# DATABASE & STORAGE IDs
# ============================================
# D1 Database IDs (from Cloudflare Dashboard or wrangler d1 create)
AUTH_D1_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NUTRITION_D1_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COACH_D1_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HEALTH_D1_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# KV Namespace IDs (from wrangler kv:namespace create)
OAUTH_STATE_KV_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# R2 Bucket Names
MEAL_IMAGES_BUCKET=aivo-meal-images
HEALTH_REPORTS_BUCKET=aivo-health-reports

# ============================================
# AI CONFIGURATION
# ============================================
AI_ENABLED=true
AI_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_MAX_TOKENS=512
AI_TEMPERATURE=0.7

# ============================================
# WASM ENGINE (Development)
# ============================================
WASM_ENGINE_ENABLED=true
WASM_ENGINE_VERSION=1.0.0
WASM_FALLBACK_TO_TYPESCRIPT=true

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development
LOG_LEVEL=debug
