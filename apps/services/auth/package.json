{
	"name": "aivo-auth",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --port 3001 --local",
		"dev:external": "wrangler dev --port 3001 --external",
		"deploy": "wrangler deploy --config wrangler.production.jsonc",
		"deploy:dev": "wrangler deploy",
		"start": "wrangler dev --port 3001",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"check-types": "echo 'Type checking disabled for auth service'",
		"lint": "eslint src --ext .ts",
		"migrate": "wrangler d1 migrations apply aivo-auth-db --local --file drizzle/0001_initial_auth_schema.sql",
		"migrate:remote": "wrangler d1 migrations apply aivo-auth-db --remote --confirm",
		"migrate:list": "wrangler d1 migrations list aivo-auth-db --local",
		"migrate:list:remote": "wrangler d1 migrations list aivo-auth-db --remote",
		"db:create": "wrangler d1 create aivo-auth-db",
		"db:execute": "wrangler d1 execute aivo-auth-db --local --file"
	},
	"dependencies": {
		"@repo/auth-core": "workspace:*",
		"@repo/queue-types": "workspace:*",
		"@repo/swagger-utils": "workspace:*",
		"hono": "^4.6.0",
		"jose": "^5.9.0",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@cloudflare/workers-types": "^4.20241205.0",
		"@repo/eslint-config": "workspace:*",
		"@types/node": "^26.4.0",
		"eslint": "^9.24.0",
		"vitest": "~4.1.0",
		"wrangler": "^4"
	}
}
