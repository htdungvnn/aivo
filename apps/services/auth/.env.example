# Auth Worker Environment Variables

# JWT Configuration
AUTH_JWT_PRIVATE_KEY=  # Base64 encoded EC private key (P-256)
AUTH_JWT_PUBLIC_KEY=   # Base64 encoded EC public key (P-256)
AUTH_JWT_ISSUER=aivo
AUTH_JWT_AUDIENCE=aivo-app
AUTH_JWT_ACCESS_TOKEN_TTL=900  # 15 minutes in seconds

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# OAuth - Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/callback/facebook

# Application URLs
WEB_APP_URL=http://localhost:3000
MOBILE_REDIRECT_URI=aivo://oauth/callback

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://aivo.app

# Cloudflare D1 Database ID (for remote deployments)
AUTH_D1_DATABASE_ID=

# Cloudflare KV Namespace ID for OAuth state storage (optional - for production)
OAUTH_STATE_KV_ID=
