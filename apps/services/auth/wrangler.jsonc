{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aivo-auth",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"assets": {
		"directory": "./public",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aivo-auth-db",
			"database_id": "fd52f067-2774-48e7-bfd0-32485b118be8",
		},
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_STATE",
			"id": "34232e5fc00f4dedb1dae02c2e8dec3f",
		},
	],
	"vars": {
		"AUTH_JWT_ISSUER": "aivo",
		"AUTH_JWT_AUDIENCE": "aivo-app",
		"AUTH_JWT_ACCESS_TOKEN_TTL": "900",
	},

	// Dev configuration (local development)
	"dev": {
		"port": 3001,
		"inspector_port": 9231,
	},
}
