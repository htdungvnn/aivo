{
  "name": "aivo-coach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 3003",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src",
    "check-types": "echo 'Type checking disabled for coach service - run cf-typegen first'",
    "db:generate": "wrangler d1 migrations generate aivo-coach-db --local",
    "db:apply": "wrangler d1 migrations apply aivo-coach-db --local",
    "db:apply:prod": "wrangler d1 migrations apply aivo-coach-db --remote --env production",
    "types": "wrangler types"
  },
  "dependencies": {
    "@aivo/auth-core": "workspace:*",
    "@aivo/fitness-types": "workspace:*",
    "@aivo/queue-types": "workspace:*",
    "@aivo/swagger-utils": "workspace:*",
    "hono": "^4.13.7",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@aivo/eslint-config": "workspace:*",
    "@aivo/typescript-config": "workspace:*",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  }
}
