{
  "name": "aivo-coach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "check-types": "tsc --noEmit",
    "db:generate": "wrangler d1 migrations generate aivo-coach-db --local",
    "db:apply": "wrangler d1 migrations apply aivo-coach-db --local",
    "db:apply:prod": "wrangler d1 migrations apply aivo-coach-db --remote --env production",
    "types": "wrangler types"
  },
  "dependencies": {
    "@repo/auth-core": "workspace:*",
    "@repo/fitness-types": "workspace:*",
    "@repo/queue-types": "workspace:*",
    "@repo/swagger-utils": "workspace:*",
    "hono": "^4.13.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.127.1"
  }
}
