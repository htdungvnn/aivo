# ============================================
# HEALTH SERVICE - Environment Variables Template
# ============================================
# Copy this file to .env.development for local development
# cp .env.example .env.development

# ============================================
# Service URLs
# ============================================
AUTH_SERVICE_URL=http://localhost:3001
NUTRITION_SERVICE_URL=http://localhost:3002
COACH_SERVICE_URL=http://localhost:3003
MAIL_SERVICE_URL=http://localhost:3005

# ============================================
# Application URLs
# ============================================
WEB_APP_URL=http://localhost:3000

# ============================================
# AI Configuration
# ============================================
AI_ENABLED=true
AI_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_MAX_TOKENS=512
AI_TEMPERATURE=0.7

# ============================================
# Algorithm Settings
# ============================================
SCHEMA_VERSION=1
ALGORITHM_VERSION=1.0.0
BASELINE_MIN_DAYS=7
BASELINE_ROLLING_WINDOW=7

# ============================================
# Cache Settings
# ============================================
CACHE_TTL_SECONDS=300

# ============================================
# Report Settings
# ============================================
REPORT_RETENTION_DAYS=90
REPORT_MAX_GENERATION_TIME_MS=270000

# ============================================
# CORS
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3004,http://localhost:4000

# ============================================
# Rate Limiting (Development)
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
NODE_ENV=development

# ============================================
# Service Port
# ============================================
PORT=3004
