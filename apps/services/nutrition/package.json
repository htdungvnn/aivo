{
  "name": "aivo-nutrition",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 3002 --local",
    "dev:external": "wrangler dev --port 3002 --external",
    "deploy": "wrangler deploy --config wrangler.production.jsonc",
    "deploy:dev": "wrangler deploy",
    "start": "wrangler dev --port 3002",
    "test": "vitest",
    "cf-typegen": "wrangler types",
    "check-types": "echo 'Type checking disabled for nutrition service - run cf-typegen first'",
    "lint": "eslint src --ext .ts",
    "migrate": "wrangler d1 migrations apply aivo-nutrition-db --local",
    "migrate:remote": "wrangler d1 migrations apply aivo-nutrition-db --remote --confirm",
    "migrate:list": "wrangler d1 migrations list aivo-nutrition-db --local",
    "migrate:list:remote": "wrangler d1 migrations list aivo-nutrition-db --remote",
    "db:create": "wrangler d1 create aivo-nutrition-db",
    "queue:consume": "wrangler queues consumer add aivo-nutrition-queue --script aivo-nutrition --local"
  },
  "dependencies": {
    "@aivo/nutrition-types": "workspace:*",
    "@aivo/queue-types": "workspace:*",
    "@aivo/swagger-utils": "workspace:*",
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@aivo/eslint-config": "workspace:*",
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260901.1",
    "eslint": "^10.9.1",
    "typescript": "^7.0.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.127.1"
  }
}
