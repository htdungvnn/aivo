{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@repo/auth": "workspace:*",
    "@repo/brand": "workspace:*",
    "@vinext/cloudflare": "latest",
    "better-auth": "1.7.12",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@repo/eslint-config": "workspace:*",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "cf": "latest",
    "eslint": "^10.9.1",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "8.3.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "vite preview",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
