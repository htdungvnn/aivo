/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	/**
	 * Better Auth relies on AsyncLocalStorage for async context tracking.
	 */
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Bindings
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aivo",
			"database_id": "6da2a146-c4fe-4c6d-8fdf-37529659252e",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * Cloudflare Email Service — used for verification and password reset.
	 *
	 * `AUTH_EMAIL_FROM` must be an address on an onboarded sending domain.
	 */
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	/**
	 * Non-secret configuration.
	 *
	 * Secrets (BETTER_AUTH_SECRET, OAuth client secrets) are set with
	 * `wrangler secret put` and never live here.
	 *
	 * These values are the deployed ones. Local development overrides them
	 * with `apps/api/.dev.vars`, which is not committed.
	 */
	"vars": {
		"BETTER_AUTH_URL": "https://api.htdung-aivo.workers.dev",
		"WEB_APP_URL": "https://web.htdung-aivo.workers.dev",
		"AUTH_EMAIL_FROM": "auth@mail.aivo.website"
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Environment-specific values use `[env.*]` blocks and per-env vars.
	 */
	// "services": [   {   "binding": "MY_SERVICE",   "service": "my-service" } ]
}
