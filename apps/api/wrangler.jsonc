/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	/**
	 * Better Auth relies on AsyncLocalStorage for async context tracking.
	 */
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Bindings
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aivo",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * Cloudflare Email Service — used for verification and password reset.
	 * `AUTH_EMAIL_FROM` must be a verified sending address on this binding.
	 */
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	/**
	 * Non-secret configuration. Secrets (BETTER_AUTH_SECRET, OAuth client
	 * secrets) are set with `wrangler secret put` and never live here.
	 */
	"vars": {
		"BETTER_AUTH_URL": "http://localhost:3001",
		"WEB_APP_URL": "http://localhost:3000",
		"AUTH_EMAIL_FROM": "auth@aivo.app"
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Environment-specific values use `[env.*]` blocks and per-env vars.
	 */
	// "services": [   {   "binding": "MY_SERVICE",   "service": "my-service" } ]
}
