{
  "name": "@aivo/readiness-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./wasm": {
      "import": "./dist/readiness_engine.js",
      "types": "./dist/readiness_engine.d.ts"
    }
  },
  "scripts": {
    "build": "wasm-pack build --target bundler --out-dir dist 2>/dev/null || echo 'WASM build skipped: Rust toolchain not available'",
    "build:ts": "tsc --emitDeclarationOnly",
    "build:node": "wasm-pack build --target nodejs --out-dir dist-node",
    "build:release": "wasm-pack build --target bundler --out-dir dist --release",
    "wasm#build": "wasm-pack build --target bundler --out-dir dist",
    "wasm#build:release": "wasm-pack build --target bundler --out-dir dist --release",
    "test": "cargo test",
    "test:wasm": "wasm-pack test --node",
    "check": "cargo check && cargo clippy -- -D warnings"
  },
  "devDependencies": {
    "@aivo/wasm-core": "workspace:*",
    "@repo/common-types": "workspace:*",
    "@repo/health-types": "workspace:*",
    "typescript": "^5.4.0",
    "wasm-pack": "^0.13.0"
  },
  "peerDependencies": {
    "@repo/common-types": ">=1.0.0",
    "@repo/health-types": ">=1.0.0"
  },
  "dependencies": {
    "@aivo/wasm-core": "workspace:*"
  }
}
