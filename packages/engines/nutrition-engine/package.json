{
  "name": "@aivo/nutrition-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./wasm": {
      "import": "./dist/nutrition_engine.js",
      "types": "./dist/nutrition_engine.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && (wasm-pack build --target bundler --out-dir dist 2>/dev/null || echo 'WASM build skipped: Rust toolchain not available')",
    "build:ts": "tsc --emitDeclarationOnly",
    "build:node": "wasm-pack build --target nodejs --out-dir dist-node",
    "build:release": "wasm-pack build --target bundler --out-dir dist --release",
    "wasm#build": "wasm-pack build --target bundler --out-dir dist",
    "wasm#build:release": "wasm-pack build --target bundler --out-dir dist --release",
    "test": "echo 'Nutrition engine tests require Rust toolchain'",
    "test:wasm": "wasm-pack test --node",
    "check": "cargo check && cargo clippy -- -D warnings"
  },
  "devDependencies": {
    "@aivo/wasm-core": "workspace:*",
    "typescript": "^7.0.2",
    "wasm-pack": "^0.15.0"
  },
  "dependencies": {
    "@aivo/wasm-core": "workspace:*"
  }
}
