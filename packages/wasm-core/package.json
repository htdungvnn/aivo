{
  "name": "@aivo/wasm-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "wasm-pack build --target bundler --out-dir dist",
    "build:node": "wasm-pack build --target nodejs --out-dir dist-node",
    "build:web": "wasm-pack build --target web --out-dir dist-web",
    "dev": "wasm-pack build --target bundler --out-dir dist --dev",
    "test": "wasm-pack test --node",
    "check": "cargo check && cargo clippy -- -D warnings"
  },
  "devDependencies": {
    "@repo/common-types": "workspace:*",
    "wasm-pack": "^0.13.0"
  },
  "peerDependencies": {
    "@repo/common-types": ">=1.0.0"
  }
}
