{
  "name": "@aivo/observability",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./worker": {
      "import": "./src/worker.ts",
      "types": "./src/worker.ts"
    },
    "./http/server": {
      "import": "./src/http/server.ts",
      "types": "./src/http/server.ts"
    },
    "./http/client": {
      "import": "./src/http/client.ts",
      "types": "./src/http/client.ts"
    },
    "./queue/producer": {
      "import": "./src/queue/producer.ts",
      "types": "./src/queue/producer.ts"
    },
    "./queue/consumer": {
      "import": "./src/queue/consumer.ts",
      "types": "./src/queue/consumer.ts"
    },
    "./database": {
      "import": "./src/database/instrumentation.ts",
      "types": "./src/database/instrumentation.ts"
    },
    "./wasm": {
      "import": "./src/wasm/instrumentation.ts",
      "types": "./src/wasm/instrumentation.ts"
    },
    "./ai": {
      "import": "./src/ai/instrumentation.ts",
      "types": "./src/ai/instrumentation.ts"
    },
    "./testing": {
      "import": "./src/tests/helpers.ts",
      "types": "./src/tests/helpers.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@aivo/eslint-config": "workspace:*",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "typescript": "^7.0.2",
    "vitest": "~4.1.11"
  }
}
