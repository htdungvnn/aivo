{
  "name": "@aivo/nutrition-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./wasm": {
      "import": "./dist/nutrition_engine.js",
      "types": "./dist/nutrition_engine.d.ts"
    }
  },
  "scripts": {
    "build": "wasm-pack build --target bundler --out-dir dist",
    "build:ts": "tsc --emitDeclarationOnly",
    "build:node": "wasm-pack build --target nodejs --out-dir dist-node",
    "dev": "wasm-pack build --target bundler --out-dir dist --dev --watch",
    "test": "wasm-pack test --node && cargo test",
    "check": "cargo check && cargo clippy -- -D warnings"
  },
  "devDependencies": {
    "@aivo/wasm-core": "workspace:*",
    "typescript": "^5.4.0",
    "wasm-pack": "^0.13.0"
  },
  "dependencies": {
    "@aivo/wasm-core": "workspace:*"
  }
}
