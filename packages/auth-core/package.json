{
  "name": "@repo/auth-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./types": {
      "import": "./src/types/index.ts",
      "types": "./src/types/index.ts"
    },
    "./jwt": {
      "import": "./src/jwt.ts",
      "types": "./src/jwt.ts"
    },
    "./middleware": {
      "import": "./src/middleware/index.ts",
      "types": "./src/middleware/index.ts"
    },
    "./errors": {
      "import": "./src/errors.ts",
      "types": "./src/errors.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "pnpm exec eslint src/ --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "^5.9.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250415.0",
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "hono": "^4.6.0",
    "typescript": "^5.7.0",
    "vitest": "~4.1.0"
  }
}
