{
  "name": "@aivo/auth-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./types": {
      "import": "./src/types/index.ts",
      "types": "./src/types/index.ts"
    },
    "./jwt": {
      "import": "./src/jwt.ts",
      "types": "./src/jwt.ts"
    },
    "./middleware": {
      "import": "./src/middleware/index.ts",
      "types": "./src/middleware/index.ts"
    },
    "./errors": {
      "import": "./src/errors.ts",
      "types": "./src/errors.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "pnpm exec eslint src/ --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "zod": "^4.6.1"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "devDependencies": {
    "@aivo/eslint-config": "workspace:*",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "hono": "^4.13.7",
    "typescript": "^7.0.2",
    "vitest": "~5.0.0"
  }
}
